{
  "name": "dsh-intelligent-ui",
  "version": "0.2.1-alpha.1.iui.1.0.0",
  "type": "module",
  "description": "DSH 原生交互式回答：智能聊天与按需技能。",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./prompt": "./src/host/prompt.mjs",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulagala001/dsh-intelligent-ui.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:host": "node --test --test-concurrency=1 test/host/*.test.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "src",
    "lib",
    "presets",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/resource-research.md",
    "docs/usage.md",
    "release-manifest.json",
    "docs/images",
    "README_EN.md",
    "docs/usage.en.md",
    "docs/release-1.0.0.md",
    "docs/release-1.0.0.en.md",
    "docs/contracts.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@openai/apps-sdk-ui": "0.2.2",
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "playwright": "1.63.0",
    "yaml": "2.8.1",
    "ws": "8.21.3",
    "@openuidev/lang-core": "0.3.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh": "0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
